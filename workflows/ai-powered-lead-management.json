      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    filterGroups: [\n      {\n        filters: [\n          {\n            propertyName: \"email\",\n            operator: \"EQ\",\n            value: $json.email\n          }\n        ]\n      }\n    ],\n    properties: [\"email\", \"firstname\", \"lastname\", \"phone\", \"company\"],\n    limit: 1\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        160,
        -304
      ],
      "id": "62e9543a-8d93-42df-b407-0acc3d59149f",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "\nconst name = String($json.name ?? \"\").trim();\nconst email = String($json.email ?? \"\").trim().toLowerCase();\nconst phone = String($json.phone ?? \"\").trim();\nconst company = String($json.company ?? \"\").trim();\nconst serviceNeeded = String($json.service_needed ?? \"\").trim();\nconst message = String($json.message ?? \"\").trim();\nconst source = String($json.source ?? \"unknown\").trim();\nconst projectTimeline = String($json.project_timeline ?? \"\").trim();\n\nconst rawBudget = $json.budget;\nconst budget = Number(rawBudget);\n\nconst errors = [];\n\nif (!name) {\n  errors.push(\"Name is required\");\n}\n\nconst emailIsValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\nif (!emailIsValid) {\n  errors.push(\"A valid email is required\");\n}\n\nif (!phone) {\n  errors.push(\"Phone number is required\");\n}\n\nif (\n  rawBudget === \"\" ||\n  rawBudget === null ||\n  rawBudget === undefined ||\n  !Number.isFinite(budget) ||\n  budget < 0\n) {\n  errors.push(\"Budget must be a non-negative number\");\n}\n\nconst nameParts = name.split(/\\s+/).filter(Boolean);\nconst firstName = nameParts[0] ?? \"\";\nconst lastName = nameParts.slice(1).join(\" \");\n\nreturn {\n  json: {\n    name,\n    first_name: firstName,\n    last_name: lastName,\n    email,\n    phone,\n    company,\n    service_needed: serviceNeeded,\n    budget,\n    project_timeline: projectTimeline,\n    message,\n    source,\n    is_valid: errors.length === 0,\n    validation_errors: errors\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
